+#[cfg(test)]
+mod stderr_tests {
+    use super::stderr_is_informational;
+
+    #[test]
+    fn recognizes_python_logging_without_hiding_errors() {
+        assert!(stderr_is_informational("2026-10-24 15:05:14,405 - onnxocr - INFO - use_npu: False"));
+        assert!(stderr_is_informational("[15:05:25.445] [app_registry.py 84] [INFO]: 应用注册完成"));
+        assert!(stderr_is_informational("2026-10-24 15:05:14,405 INFO MainThread app:ready"));
+        assert!(!stderr_is_informational("2026-10-24 15:05:14,405 - onnxocr - ERROR - failed INFO"));
+        assert!(!stderr_is_informational("Traceback (most recent call last):"));
+        assert!(!stderr_is_informational("RuntimeError: INFO unavailable"));
+    }
+}
