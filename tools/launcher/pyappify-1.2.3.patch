+// Only downgrade recognized logging records, never arbitrary stderr containing
+// the word INFO (tracebacks and unstructured diagnostics remain errors).
+fn stderr_is_informational(line: &str) -> bool {
+    static RECORD: std::sync::LazyLock<regex::Regex> = std::sync::LazyLock::new(|| regex::Regex::new(
+        r"^(?:\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}[,.]\d+ - .+? - (?:DEBUG|INFO|WARNING) - |\[\d{2}:\d{2}:\d{2}\.\d+\] \[[^\]\r\n]+\] \[(?:DEBUG|INFO|WARNING)\]:|\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}[,.]\d+ (?:DEBUG|INFO|WARNING) )"
+    ).expect("valid stderr log pattern"));
+    RECORD.is_match(line)
+}
